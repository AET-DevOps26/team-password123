POSTGRES_DB=nutrition

POSTGRES_USER=nutrition

POSTGRES_PASSWORD=nutrition

APP_JWT_SECRET=replace-with-at-least-32-characters-for-local-dev

APP_JWT_EXPIRATION=PT24H



# Grafana admin login (docker-compose). Required — no default. The deployed

# Helm chart sources this from a Secret, not this file.

GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password



# ── GenAI photo-scan (meals-service → genai-service → vision LLM) ──

# Primary: Gemini via Google's OpenAI-compatible endpoint.

# Backup: Nemotron on OpenRouter (used automatically when Gemini fails).

# Keys are read only via this gitignored .env — never commit them.

LLM_PROVIDER=openai

OPENAI_MODEL=gemini-3.1-flash-lite

OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENAI_API_KEY=AIza...

BACKUP_OPENAI_BASE_URL=https://openrouter.ai/api/v1

BACKUP_OPENAI_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

BACKUP_OPENAI_API_KEY=sk-or-v1-...


