# Backend service URLs used by the Vite dev proxy (see vite.config.ts).
# Defaults already target the services started by docker-compose on localhost,
# so you only need to override these if a service runs elsewhere.
VITE_AUTH_API_URL=http://localhost:8081
VITE_MEALS_API_URL=http://localhost:8082
VITE_ANALYTICS_API_URL=http://localhost:8083
