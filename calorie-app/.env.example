VITE_API_URL=http://localhost:8081

# Feature flags
# Enable mock data (seeded meals, nutrition stats, insights history).
# Set to true for local development without a running backend.
VITE_MOCK_MODE=false

# Enable offline mode: all API requests return empty responses instead of
# network errors. Useful to preview the app as a brand-new user.
# Auth still shows the login screen; any credentials will "succeed".
VITE_OFFLINE_MODE=false
