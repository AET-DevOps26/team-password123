# GenAI Service Configuration
#
# LLM providers: "ollama" (local), "openai" (cloud), or "google" (Gemini API)
LLM_PROVIDER=ollama

# Ollama settings (used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# OpenAI settings (used if LLM_PROVIDER=openai or as fallback)
# OPENAI_API_KEY=sk-...

# Google Gemini settings (used if LLM_PROVIDER=google or as fallback)
# GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-2.0-flash

# Nutrition data sources: usda, local, or auto
NUTRITION_DATA_PROVIDER=usda
# USDA FoodData Central API key (primary nutrition source)
USDA_FDC_API_KEY=...

# GenAI service port and debug mode
PORT=8084
DEBUG=true

# --- RAG health insights (Weaviate vector store) ---
# Weaviate endpoint (genai supplies the vectors; vectorizer: none)
WEAVIATE_URL=http://weaviate:8080
# Embedding provider: "local" (fastembed BAAI/bge-small-en-v1.5, 384-dim, offline,
# no torch) or "openai" (text-embedding-3-small, 1536-dim, needs OPENAI_API_KEY)
EMBED_PROVIDER=local
EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5
OPENAI_EMBED_MODEL=text-embedding-3-small
# Path to the curated facts corpus (defaults to the bundled health_facts.json)
# HEALTH_FACTS_PATH=health_facts.json
# Number of facts retrieved per insight query
INSIGHT_TOPK=5
