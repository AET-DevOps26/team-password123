# GenAI Service Configuration
#
# LLM providers: "openai" (Gemini/OpenAI-compatible) or "google" (Gemini API)
LLM_PROVIDER=openai

# OpenAI settings (used if LLM_PROVIDER=openai or as fallback)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=sk-...

# Backup OpenAI-compatible vision endpoint (Nemotron on OpenRouter)
# BACKUP_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# BACKUP_OPENAI_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# BACKUP_OPENAI_API_KEY=sk-or-v1-...
# BACKUP_OPENAI_MAX_TOKENS=256
# BACKUP_VISION_TIMEOUT_SEC=90
# BACKUP_VISION_MAX_SIDE=512

# Google Gemini settings (used if LLM_PROVIDER=google or as fallback)
# GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-2.0-flash

# Text LLM for food-name estimation + the health-insight RAG generation.
# Defaults to AET Logos gpt-oss-120b; set the key to enable generation
# (without it those paths fail soft — retrieval-only for insights).
TEXT_OPENAI_BASE_URL=https://logos.aet.cit.tum.de/v1
TEXT_OPENAI_MODEL=openai/gpt-oss-120b
# TEXT_OPENAI_API_KEY=<Logos key>

# Nutrition data sources: usda, local, or auto
NUTRITION_DATA_PROVIDER=usda
# USDA FoodData Central API key (primary nutrition source)
USDA_FDC_API_KEY=...

# GenAI service port and debug mode
PORT=8084
DEBUG=true

# --- RAG health insights (Weaviate vector store) ---
# Weaviate endpoint (genai supplies the vectors; vectorizer: none)
WEAVIATE_URL=http://weaviate:8080
# Embedding provider: "local" (fastembed BAAI/bge-small-en-v1.5, 384-dim, offline,
# no torch) or "openai" (text-embedding-3-small, 1536-dim, needs OPENAI_API_KEY)
EMBED_PROVIDER=local
EMBED_MODEL_LOCAL=BAAI/bge-small-en-v1.5
OPENAI_EMBED_MODEL=text-embedding-3-small
# Path to the curated facts corpus (defaults to the bundled health_facts.json)
# HEALTH_FACTS_PATH=health_facts.json
# Number of facts retrieved per insight query
INSIGHT_TOPK=5
