# GenAI Service Configuration
#
# LLM providers: "ollama" (local), "openai" (cloud), or "google" (Gemini API)
LLM_PROVIDER=ollama

# Ollama settings (used if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# OpenAI settings (used if LLM_PROVIDER=openai or as fallback)
# OPENAI_API_KEY=sk-...

# Google Gemini settings (used if LLM_PROVIDER=google or as fallback)
# GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-2.0-flash

# Nutrition data sources: usda, local, or auto
NUTRITION_DATA_PROVIDER=usda
# USDA FoodData Central API key (primary nutrition source)
USDA_FDC_API_KEY=...

# GenAI service port and debug mode
PORT=8084
DEBUG=true
